# Hosted conversation model
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# development | production
APP_ENV=development

# Required local five-level risk classifier
LOCAL_MODEL_DIR=models/inhouse_risk_classifier

# Required fine-tuned transformer heads for emotion, topic, and semantic slots
LOCAL_NLP_MODEL_DIR=models/inhouse_nlp

# Optional Phase 2 local dialogue adapter; takes priority over Groq when enabled
ENABLE_LOCAL_DIALOGUE_MODEL=false
LOCAL_DIALOGUE_MODEL_DIR=models/inhouse_llama_dialogue
LOCAL_DIALOGUE_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Temporary session storage
ENABLE_REDIS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TTL_SECONDS=3600

# SQLite locally; PostgreSQL is required when APP_ENV=production
DATABASE_URL=sqlite:///data/mindtriage.db
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Only explicitly consented, redacted conversations are written here
CONVERSATIONS_LOG_PATH=data/conversations.jsonl
MAX_MESSAGE_CHARS=4000
