# --- LLM ---
GROK_API_KEY=xai-xxxxx
GROK_MODEL=grok-2-latest

# --- Session store (ephemeral) ---
# Leave unset to use in-process fakeredis for local dev.
REDIS_URL=

# --- Anonymized metadata store ---
# Defaults to local SQLite; swap for a Postgres DSN once Docker Compose is stood up.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Auth ---
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256

# --- In-house model / retraining ---
RETRAIN_EVERY_N_SESSIONS=50
INHOUSE_MODEL_ARTIFACT_DIR=../inhouse_model/artifacts

# --- Misc ---
SESSION_IDLE_TIMEOUT_MINUTES=30
